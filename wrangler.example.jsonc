{
  // Copy this file to wrangler.jsonc and set database_id. See "Cloudflare Worker" in README.md.
  "name": "trackin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackin",
      "database_id": "<your-database-id>",
      "migrations_dir": "migrations"
    }
  ]
}
