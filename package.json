{
  "name": "trackin",
  "version": "0.0.1",
  "description": "Tiny event tracking for the browser, Node/Bun and React Native. No cookies, no fingerprinting, no dependencies.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "analytics",
    "tracking",
    "events",
    "privacy",
    "sendbeacon",
    "react-native",
    "cloudflare-workers",
    "d1",
    "bun"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
      "default": "./dist/ingest.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "size": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "server": "bun run src/server.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:migrate:local": "wrangler d1 migrations apply trackin --local",
    "worker:migrate": "wrangler d1 migrations apply trackin --remote"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.161.0"
  }
}
